enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Club {
  id                       String         @id @default(cuid())
  clerkOrgId               String         @unique
  name                     String
  approvalStatus           ApprovalStatus @default(PENDING)
  description              String?
  baselineBudgetAmount     Decimal
  brainstormCanvasJsonPath String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id])
  institutionId String

  applications          ClubApplication[]
  events                Event[]
  eventApprovalRequests EventApprovalRequest[]
  fundingRequests       FundingRequest[]
  budgetCategories      BudgetCategory[]
  budgetEntries         BudgetEntry[]
  brainstormIdeas       BrainstormIdea[]
  overspendFlags        OverspendFlag[]

  @@index([institutionId])
  @@index([clerkOrgId])
}

model OverspendFlag {
  id         String    @id @default(cuid())
  flaggedAt  DateTime  @default(now())
  resolvedAt DateTime?

  club   Club   @relation(fields: [clubId], references: [id])
  clubId String

  // Set to `clubId` while the flag is open and `null` once resolved. A plain
  // `@@unique([clubId, resolvedAt])` wouldn't enforce "at most one open flag
  // per club" — Postgres treats every NULL `resolvedAt` as distinct, so
  // multiple resolved rows are fine, but this field's uniqueness is what
  // actually blocks two simultaneously-open flags for the same club and
  // gives the job's upsert a stable key to target.
  openKey String? @unique

  @@index([clubId])
}

model ClubApplication {
  id                  String         @id @default(cuid())
  answers             Json
  schemaSnapshot      Json
  status              ApprovalStatus @default(PENDING)
  proposedAdminUserId String
  proposedAdminEmail  String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id])
  institutionId String

  resultingClub   Club?   @relation(fields: [resultingClubId], references: [id])
  resultingClubId String?

  @@index([institutionId])
  @@index([institutionId, status])
}
